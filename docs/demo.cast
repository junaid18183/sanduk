{"version":3,"term":{"cols":80,"rows":24},"timestamp":1792417037,"command":"./docs/demo.sh","env":{"SHELL":"/bin/bash"}}
[1.026, "o", "\u001b[2m# Store a key. The value is prompted for, never passed in argv.\u001b[0m\r\n"]
[0.509, "o", "\u001b[1;32m$\u001b[0m printf 'sk-test-DEMO-VALUE\\n' | sanduk add openai --as OPENAI_API_KEY\r\n"]
[0.888, "o", "Added secret \"openai\"\r\n"]
[0.005, "o", "\r\n"]
[0.708, "o", "\u001b[2m# It is in the OS keystore now, not a .env file.\u001b[0m\r\n"]
[0.511, "o", "\u001b[1;32m$\u001b[0m sanduk list\r\n"]
[0.869, "o", "NAME    TYPE    ENV / INFO\r\nopenai  secret  OPENAI_API_KEY\r\n"]
[0.005, "o", "\r\n"]
[0.706, "o", "\u001b[2m# Run a command with it injected:\u001b[0m\r\n"]
[0.514, "o", "\u001b[1;32m$\u001b[0m sanduk exec openai -- sh -c 'echo \"the child sees: $OPENAI_API_KEY\"'\r\n"]
[0.872, "o", "the child sees: sk-test-DEMO-VALUE\r\n"]
[0.000, "o", "\r\n"]
[0.708, "o", "\u001b[2m# ...and it was never in your own shell:\u001b[0m\r\n"]
[0.510, "o", "\u001b[1;32m$\u001b[0m echo \"this shell sees: ${OPENAI_API_KEY:-<unset>}\"\r\n"]
[0.408, "o", "this shell sees: <unset>\r\n\r\n"]
[0.708, "o", "\u001b[2m# Share one key across projects with a link, not a copy.\u001b[0m\r\n"]
[0.513, "o", "\u001b[1;32m$\u001b[0m sanduk add-group warden --from-dotenv <(printf 'DB_URL=postgres://localhost/app\\n')\r\n"]
[1.684, "o", "Added group \"warden\" with 1 field(s)\r\n"]
[0.009, "o", "\r\n"]
[0.709, "o", "\u001b[1;32m$\u001b[0m sanduk group link warden openai\r\n"]
[1.699, "o", "Linked OPENAI_API_KEY in group \"warden\" -> secret \"openai\"\r\n"]
[0.008, "o", "\r\n"]
[0.707, "o", "\u001b[1;32m$\u001b[0m sanduk group show warden --long\r\n"]
[0.859, "o", "KEY              SOURCE\r\nDB_URL           stored\r\nOPENAI_API_KEY   -> openai\r\n2 field(s) in group \"warden\", 1 linked\r\n"]
[0.005, "o", "\r\n"]
[0.708, "o", "\u001b[2m# Rotate the secret once; every group that links it follows.\u001b[0m\r\n"]
[0.512, "o", "\u001b[1;32m$\u001b[0m printf 'sk-test-ROTATED\\n' | sanduk rotate openai\r\n"]
[1.742, "o", "Rotated secret \"openai\"\r\n"]
[0.014, "o", "\r\n"]
[0.709, "o", "\u001b[1;32m$\u001b[0m sanduk export warden --format dotenv\r\n"]
[0.857, "o", "DB_URL=postgres://localhost/app\r\nOPENAI_API_KEY=sk-test-ROTATED\r\n"]
[0.004, "o", "\r\n"]
[0.708, "o", "\u001b[2m# And find the copies that escaped. Here is one, checked into the repo:\u001b[0m\r\n"]
[0.513, "o", "\u001b[1;32m$\u001b[0m cat settings.py\r\n"]
[0.420, "o", "OPENAI_API_KEY = \"sk-test-ROTATED\"\r\n"]
[0.001, "o", "\r\n"]
[0.711, "o", "\u001b[1;32m$\u001b[0m sanduk scan . --yes\r\n"]
[0.861, "o", "ENTRY    LOCATION\r\nopenai   settings.py:1\r\nsanduk: 1 leaked copy/copies found; rotate the affected secrets\r\n"]
[0.005, "o", "\r\n"]
[1.739, "x", "0"]
