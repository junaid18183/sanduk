# The values `make setup` loads into the vault. Obvious dummies: this demo
# never involves a real secret, so it is safe to read and safe to run.
#
# These are the keys the project needs, minus LEGACY_TOKEN. That omission is
# deliberate — it is what makes `make doctor` report drift, and what
# `make add-legacy` then fixes. See .env.example for the full contract.

DB_URL=postgres://user:password@localhost:5432/app
REDIS_URL=redis://localhost:6379
API_KEY=demo-api-key-not-secret
STRIPE_KEY=sk_test_dummy
SENTRY_DSN=https://example.invalid/1
SMTP_PASSWORD=demo-password-not-secret
