# Optional direnv integration (https://direnv.net). Non-secret, safe to commit.
#
# This file deliberately does NOT load the secrets into your shell. Exporting
# them would put them in every child process of this terminal — including any AI
# agent running in it — which is exactly what sanduk exists to avoid. Run things
# with the project's secrets instead:
#
#   make dev
#   sanduk exec "$DEMO_ENTRY" -- <command>
#
# If a tool really needs them in the environment (an editor plugin, say), opt in
# by hand, for that shell only, and never let that shell be the one an agent
# runs in:
#
#   eval "$(sanduk export "$DEMO_ENTRY" --format shell)"

# DEMO_ENTRY is this demo's own setting, read by the Makefile and setup.sh.
# It is deliberately not SANDUK_*: that prefix is reserved for sanduk, which
# strips it from every child process.
export DEMO_ENTRY=demo
