# The variables this project expects, with dummy values.
#
# Commit this file. It documents the contract — which environment variables the
# app needs — without holding a single real secret. `sanduk doctor` compares
# your vault entry against it and reports the difference in both directions:
# a key the app needs but nobody stored, and a key stored but no longer used.
#
# Every value here is a placeholder. Real values live in your OS keystore.

DB_URL=postgres://demo:not-secret@localhost:5432/app
REDIS_URL=redis://localhost:6379
API_KEY=demo-api-key-not-secret
STRIPE_KEY=demo-stripe-key-not-secret
SENTRY_DSN=https://example.invalid/1
SMTP_PASSWORD=demo-password-not-secret
LEGACY_TOKEN=demo-legacy-token-not-secret
